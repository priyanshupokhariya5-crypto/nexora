# Nexora Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Database URI (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora?retryWrites=true&w=majority

# JWT Secret Key for Admin & User Authentication Token Signatures
JWT_SECRET=nexora_jwt_secret_key_2026_prod

# Resend API Key for Newsletter Confirmation & Transactional Emails
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Newsletter From Email Address
# Example: Nexora Updates <onboarding@resend.dev> or custom verified domain
NEWSLETTER_FROM=Nexora <onboarding@resend.dev>
